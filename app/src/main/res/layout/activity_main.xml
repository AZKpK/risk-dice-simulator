<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Risk Dice Simulator"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Attacker Armies:"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etAttackerArmies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 10"
            android:inputType="number"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Defender Armies:"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etDefenderArmies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 8"
            android:inputType="number"
            android:layout_marginBottom="24dp" />

        <CheckBox
            android:id="@+id/cbCapitalDefense"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Capital Defense (Defender rolls up to 3 dice)"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnRollOnce"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Roll Single Round"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnFightToDeath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fight To The Death"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSimulate1000"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simulate 1,000 Battles"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter army counts and choose an action."
            android:textSize="16sp"
            android:padding="12dp"
            android:background="#EFEFEF"
            android:textColor="#333333" />

    </LinearLayout>
</ScrollView>