<?xml version="1.0" encoding="utf-8"?>
<!-- Port of the v0 RiskSimulator page (components/risk/*.tsx). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.example.riskdicesimulator.MaxWidthLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:divider="@drawable/gap_16"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="24dp"
            android:paddingEnd="16dp"
            android:paddingBottom="40dp"
            android:showDividers="middle">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.example.riskdicesimulator.CssTextView
                        android:id="@+id/title"
                        style="@style/Text.Xl.Semibold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title" />

                    <com.example.riskdicesimulator.CssTextView
                        style="@style/Text.Sm.Muted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/subtitle" />
                </LinearLayout>

                <com.example.riskdicesimulator.IconButton
                    android:id="@+id/reset"
                    style="@style/Risk.Button.Sm.Outline"
                    android:layout_width="wrap_content"
                    android:contentDescription="@string/reset">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_rotate_ccw"
                        app:tint="@color/foreground" />

                    <com.example.riskdicesimulator.CssTextView
                        style="@style/Risk.ButtonText.Sm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/reset" />
                </com.example.riskdicesimulator.IconButton>
            </LinearLayout>

            <!-- Army inputs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:divider="@drawable/gap_12"
                android:orientation="horizontal"
                android:showDividers="middle">

                <include
                    android:id="@+id/attackerCard"
                    layout="@layout/army_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/defenderCard"
                    layout="@layout/army_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- Capital toggle -->
            <LinearLayout
                android:id="@+id/capitalRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_2xl"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center_vertical"
                android:importantForAccessibility="no"
                android:orientation="horizontal"
                android:paddingStart="17dp"
                android:paddingTop="13dp"
                android:paddingEnd="17dp"
                android:paddingBottom="13dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_castle"
                    app:tint="@color/defender" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.example.riskdicesimulator.CssTextView
                        style="@style/Text.Sm.Medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/capital_title" />

                    <com.example.riskdicesimulator.CssTextView
                        style="@style/Text.Xs.Muted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/capital_subtitle" />
                </LinearLayout>

                <com.example.riskdicesimulator.RiskSwitch
                    android:id="@+id/capitalSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/capital_title" />
            </LinearLayout>

            <!-- Dice arena -->
            <LinearLayout
                android:id="@+id/arena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:divider="@drawable/gap_16"
                android:orientation="vertical"
                android:padding="17dp"
                android:showDividers="middle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.example.riskdicesimulator.CssTextView
                        style="@style/Text.Xs"
                        android:layout_width="32dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/geist_semibold"
                        android:letterSpacing="0.05"
                        android:text="@string/atk"
                        android:textAllCaps="true"
                        android:textColor="@color/attacker" />

                    <LinearLayout
                        android:id="@+id/attackerDice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:clipChildren="false"
                        android:divider="@drawable/gap_12"
                        android:orientation="horizontal"
                        android:showDividers="middle" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.example.riskdicesimulator.CssTextView
                        style="@style/Text.Xs"
                        android:layout_width="32dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/geist_semibold"
                        android:letterSpacing="0.05"
                        android:text="@string/def"
                        android:textAllCaps="true"
                        android:textColor="@color/defender" />

                    <LinearLayout
                        android:id="@+id/defenderDice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:clipChildren="false"
                        android:divider="@drawable/gap_12"
                        android:orientation="horizontal"
                        android:showDividers="middle" />
                </LinearLayout>

                <com.example.riskdicesimulator.CssTextView
                    android:id="@+id/caption"
                    style="@style/Text.Sm.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center_horizontal" />
            </LinearLayout>

            <!-- Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/gap_12"
                android:orientation="horizontal"
                android:showDividers="middle">

                <com.example.riskdicesimulator.IconButton
                    android:id="@+id/rollOnce"
                    style="@style/Risk.Button.Lg.Primary"
                    android:layout_width="0dp"
                    android:layout_weight="1">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_dices"
                        app:tint="@color/primary_foreground" />

                    <com.example.riskdicesimulator.CssTextView
                        style="@style/Risk.ButtonText.Lg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/roll_once"
                        android:textColor="@color/primary_foreground" />
                </com.example.riskdicesimulator.IconButton>

                <com.example.riskdicesimulator.IconButton
                    android:id="@+id/rollAll"
                    style="@style/Risk.Button.Lg.Secondary"
                    android:layout_width="0dp"
                    android:layout_weight="1">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_fast_forward"
                        app:tint="@color/foreground" />

                    <com.example.riskdicesimulator.CssTextView
                        style="@style/Risk.ButtonText.Lg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/roll_all" />
                </com.example.riskdicesimulator.IconButton>
            </LinearLayout>

            <!-- Battle log -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_3xl"
                android:divider="@drawable/gap_8"
                android:orientation="vertical"
                android:padding="17dp"
                android:showDividers="middle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/logToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.example.riskdicesimulator.CssTextView
                            style="@style/Text.Sm.Semibold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/battle_log" />

                        <com.example.riskdicesimulator.CssTextView
                            android:id="@+id/logCount"
                            style="@style/Text.Xs.Mono.Muted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp" />

                        <ImageView
                            android:id="@+id/logChevron"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="6dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="@color/muted_foreground" />
                    </LinearLayout>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <com.example.riskdicesimulator.IconButton
                        android:id="@+id/clearLog"
                        style="@style/Risk.Button.Sm.Ghost"
                        android:layout_width="wrap_content"
                        android:contentDescription="@string/clear"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_trash"
                            app:tint="@color/foreground" />

                        <com.example.riskdicesimulator.CssTextView
                            style="@style/Risk.ButtonText.Sm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/clear" />
                    </com.example.riskdicesimulator.IconButton>
                </LinearLayout>

                <com.example.riskdicesimulator.CssTextView
                    android:id="@+id/logEmpty"
                    style="@style/Text.Sm.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:paddingTop="24dp"
                    android:paddingBottom="24dp"
                    android:text="@string/log_empty"
                    android:visibility="gone" />

                <com.example.riskdicesimulator.MaxHeightRecyclerView
                    android:id="@+id/logList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:paddingEnd="4dp"
                    android:scrollbarStyle="outsideOverlay"
                    android:scrollbars="vertical"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Odds -->
            <LinearLayout
                android:id="@+id/oddsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_3xl"
                android:divider="@drawable/gap_16"
                android:orientation="vertical"
                android:padding="17dp"
                android:showDividers="middle">

                <com.example.riskdicesimulator.CssTextView
                    style="@style/Text.Sm.Semibold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/odds_title" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/gap_8"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.example.riskdicesimulator.CssTextView
                                style="@style/Text.Xs.Muted"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/attacker_wins" />

                            <com.example.riskdicesimulator.CssTextView
                                android:id="@+id/attackerWin"
                                style="@style/Text.Xl3.MonoSemibold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/attacker" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="vertical">

                            <com.example.riskdicesimulator.CssTextView
                                style="@style/Text.Xs.Muted"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/defender_holds" />

                            <com.example.riskdicesimulator.CssTextView
                                android:id="@+id/defenderHold"
                                style="@style/Text.Xl3.MonoSemibold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/defender" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.example.riskdicesimulator.BarView
                        android:id="@+id/meter"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:contentDescription="@string/attacker_win_probability" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:divider="@drawable/gap_8"
                    android:orientation="horizontal"
                    android:showDividers="middle">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_muted50_xl"
                        android:divider="@drawable/gap_2"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:showDividers="middle">

                        <com.example.riskdicesimulator.CssTextView
                            style="@style/Text.Xs.Muted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/expected_attackers" />

                        <com.example.riskdicesimulator.CssTextView
                            android:id="@+id/expectedAttackers"
                            style="@style/Text.Lg.MonoSemibold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_muted50_xl"
                        android:divider="@drawable/gap_2"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:showDividers="middle">

                        <com.example.riskdicesimulator.CssTextView
                            style="@style/Text.Xs.Muted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/expected_defenders" />

                        <com.example.riskdicesimulator.CssTextView
                            android:id="@+id/expectedDefenders"
                            style="@style/Text.Lg.MonoSemibold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nextRoll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_muted30_xl"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/nextRollToggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="10dp">

                        <com.example.riskdicesimulator.CssTextView
                            android:id="@+id/nextRollLabel"
                            style="@style/Text.Xs.Muted"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/geist_medium" />

                        <ImageView
                            android:id="@+id/nextRollChevron"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="8dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="@color/muted_foreground" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/outcomeList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="@drawable/gap_6"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="12dp"
                        android:showDividers="middle"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:divider="@drawable/gap_8"
                        android:orientation="horizontal"
                        android:paddingTop="16dp"
                        android:showDividers="middle">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <com.example.riskdicesimulator.CssTextView
                                style="@style/Text.Xs.Muted"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/rolls" />

                            <com.example.riskdicesimulator.CssTextView
                                android:id="@+id/totalRolls"
                                style="@style/Text.Base.MonoSemibold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <com.example.riskdicesimulator.CssTextView
                                style="@style/Text.Xs.Muted"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/atk_lost" />

                            <com.example.riskdicesimulator.CssTextView
                                android:id="@+id/totalAttackerLost"
                                style="@style/Text.Base.MonoSemibold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/attacker" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <com.example.riskdicesimulator.CssTextView
                                style="@style/Text.Xs.Muted"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/def_lost" />

                            <com.example.riskdicesimulator.CssTextView
                                android:id="@+id/totalDefenderLost"
                                style="@style/Text.Base.MonoSemibold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/defender" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.example.riskdicesimulator.MaxWidthLayout>
    </FrameLayout>
</androidx.core.widget.NestedScrollView>
