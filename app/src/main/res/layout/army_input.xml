<?xml version="1.0" encoding="utf-8"?>
<!-- components/risk/army-input.tsx -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:divider="@drawable/gap_8"
    android:orientation="vertical"
    android:padding="13dp"
    android:showDividers="middle">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/dot"
            android:layout_width="10dp"
            android:layout_height="10dp" />

        <com.example.riskdicesimulator.CssTextView
            android:id="@+id/label"
            style="@style/Text.Sm.Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <com.example.riskdicesimulator.CssEditText
        android:id="@+id/value"
        style="@style/Text.Xl4.MonoSemibold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@null"
        android:gravity="top|start"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="number"
        android:maxLines="1"
        android:minHeight="0dp"
        android:padding="0dp"
        android:selectAllOnFocus="true"
        android:textCursorDrawable="@null" />

    <com.example.riskdicesimulator.CssTextView
        android:id="@+id/hint"
        style="@style/Text.Xs.Muted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/gap_6"
        android:orientation="horizontal"
        android:showDividers="middle">

        <com.example.riskdicesimulator.IconButton
            android:id="@+id/minusTen"
            style="@style/Risk.Button.Sm.Secondary"
            android:layout_width="0dp"
            android:layout_weight="1">

            <com.example.riskdicesimulator.CssTextView
                style="@style/Risk.ButtonText.Sm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/minus_ten" />
        </com.example.riskdicesimulator.IconButton>

        <com.example.riskdicesimulator.IconButton
            android:id="@+id/minusOne"
            style="@style/Risk.Button.Sm.Secondary"
            android:layout_width="0dp"
            android:layout_weight="1">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_minus"
                app:tint="@color/foreground" />
        </com.example.riskdicesimulator.IconButton>

        <com.example.riskdicesimulator.IconButton
            android:id="@+id/plusOne"
            style="@style/Risk.Button.Sm.Secondary"
            android:layout_width="0dp"
            android:layout_weight="1">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_plus"
                app:tint="@color/foreground" />
        </com.example.riskdicesimulator.IconButton>

        <com.example.riskdicesimulator.IconButton
            android:id="@+id/plusTen"
            style="@style/Risk.Button.Sm.Secondary"
            android:layout_width="0dp"
            android:layout_weight="1">

            <com.example.riskdicesimulator.CssTextView
                style="@style/Risk.ButtonText.Sm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/plus_ten" />
        </com.example.riskdicesimulator.IconButton>
    </LinearLayout>
</LinearLayout>
